{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/yurirocha15/mcp-cpp-sdk/release/release-ledger.schema.json",
    "title": "mcp-cpp-sdk release ledger",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "version",
        "tag",
        "source_commit_sha",
        "release_manifest_sha256",
        "results"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
        },
        "tag": {
            "type": "string",
            "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$"
        },
        "source_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "release_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "results": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "github",
                "conan2",
                "deb_apt",
                "rpm",
                "arch_aur",
                "homebrew",
                "chocolatey"
            ],
            "properties": {
                "github": {
                    "$ref": "#/$defs/result"
                },
                "conan2": {
                    "$ref": "#/$defs/result"
                },
                "deb_apt": {
                    "$ref": "#/$defs/result"
                },
                "rpm": {
                    "$ref": "#/$defs/result"
                },
                "arch_aur": {
                    "$ref": "#/$defs/result"
                },
                "homebrew": {
                    "$ref": "#/$defs/result"
                },
                "chocolatey": {
                    "$ref": "#/$defs/result"
                }
            }
        }
    },
    "$defs": {
        "result": {
            "enum": [
                "PUBLISHED",
                "SUBMITTED_PENDING_REVIEW",
                "SUBMITTED_PENDING_MODERATION",
                "BLOCKED_MANUAL_ACTION",
                "FAILED",
                "SKIPPED_ALREADY_IDENTICAL",
                "FIRST_USE_UNPROVEN",
                "LIVE"
            ]
        }
    }
}
