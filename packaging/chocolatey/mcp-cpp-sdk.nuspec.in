<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>mcp-cpp-sdk</id>
    <version>@VERSION@</version>
    <title>Model Context Protocol C++ SDK</title>
    <authors>@AUTHORS@</authors>
    <owners>@OWNERS@</owners>
    <summary>@SUMMARY@</summary>
    <description>@DESCRIPTION@</description>
    <projectUrl>@PROJECT_URL@</projectUrl>
    <projectSourceUrl>@PROJECT_URL@/tree/v@VERSION@</projectSourceUrl>
    <packageSourceUrl>@PACKAGE_SOURCE_URL@</packageSourceUrl>
    <releaseNotes>@PROJECT_URL@/releases/tag/v@VERSION@</releaseNotes>
    <licenseUrl>@PROJECT_URL@/blob/v@VERSION@/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>@COPYRIGHT@</copyright>
    <tags>@TAGS@</tags>
    <dependencies>
      <dependency id="vcredist140" version="@VCREDIST_MIN_VERSION@" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
