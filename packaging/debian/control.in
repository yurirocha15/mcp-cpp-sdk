Source: mcp-cpp-sdk
Section: libs
Priority: optional
Maintainer: @MAINTAINER@
Build-Depends: debhelper-compat (= 13), cmake (>= 3.20), ninja-build, g++ (>= 11), libboost-dev (>= 1.74), libgtest-dev, nlohmann-json3-dev (>= 3.10.5), libssl-dev (>= 3.0), pkg-config
Standards-Version: 4.7.2
Rules-Requires-Root: no
Homepage: https://github.com/yurirocha15/mcp-cpp-sdk

Package: libmcp-cpp-sdk@ABI_VERSION@
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Model Context Protocol C++ SDK shared library
 A C++20 implementation of the Model Context Protocol for clients and servers.

Package: libmcp-cpp-sdk-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends: libmcp-cpp-sdk@ABI_VERSION@ (= ${binary:Version}), libboost-dev (>= 1.74), nlohmann-json3-dev (>= 3.10.5), libssl-dev (>= 3.0), ${misc:Depends}
Description: Model Context Protocol C++ SDK development files
 Headers, shared-library link metadata, CMake configuration, and pkg-config data.

Package: libmcp-cpp-sdk-static-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends: libmcp-cpp-sdk-dev (= ${binary:Version}), ${misc:Depends}
Description: Model Context Protocol C++ SDK static library
 Static library and private dependency metadata for explicit static consumers.
