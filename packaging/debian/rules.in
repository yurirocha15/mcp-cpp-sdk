#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/architecture.mk

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DMCP_CPP_SDK_BUILD_SHARED=ON -DMCP_CPP_SDK_BUILD_STATIC=ON -DBUILD_TESTING=ON -DMCP_CPP_SDK_CHECK_JSON_MATRIX=OFF -DBUILD_EXAMPLES=OFF -DBUILD_DOCS=OFF -DCMAKE_BUILD_TYPE=RelWithDebInfo

# The release publishes the runtime, development and static packages only.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# The tests are not packaged. Removing their build once they pass leaves the build space to the
# installed files and their copies in each package.
override_dh_auto_test:
	CTEST_OUTPUT_ON_FAILURE=1 dh_auto_test
	rm -rf obj-$(DEB_HOST_GNU_TYPE)/CMakeFiles/mcp-sdk-tests.dir obj-$(DEB_HOST_GNU_TYPE)/mcp-sdk-tests
