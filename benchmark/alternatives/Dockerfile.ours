FROM ubuntu@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    libboost-dev \
    libcurl4-openssl-dev \
    libhiredis-dev \
    libssl-dev \
    nlohmann-json3-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

ARG OURS_MODEL=threads

WORKDIR /src
COPY CMakeLists.txt VERSION LICENSE ./
COPY cmake/ cmake/
COPY include/ include/
COPY src/ src/
COPY benchmark/alternatives/ benchmark/alternatives/

# Compile jobs; the machine builds one image at a time and each translation unit needs gigabytes.
ARG BUILD_JOBS=4
RUN cmake -S /src/benchmark/alternatives -B /build \
      -DBENCHMARK_SDK=ours \
      -DBENCHMARK_SDK_SOURCE=/src \
      -DBENCHMARK_OURS_MODEL=${OURS_MODEL} \
      -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --target alternative-benchmark-server -j"${BUILD_JOBS}"

ENV PORT=8080
EXPOSE 8080
CMD ["/build/alternative-benchmark-server"]
