set(PACKAGE_VERSION "@MCP_CPP_SDK_VERSION_FULL@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)

if("@MCP_CPP_SDK_VERSION_PRERELEASE@" STREQUAL "")
  if(PACKAGE_FIND_VERSION)
    if(@MCP_CPP_SDK_VERSION_MAJOR@ EQUAL 0)
      if(NOT PACKAGE_FIND_VERSION_RANGE
         AND PACKAGE_FIND_VERSION STREQUAL "@MCP_CPP_SDK_VERSION_CORE@")
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
      endif()
    elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL @MCP_CPP_SDK_VERSION_MAJOR@
           AND NOT PACKAGE_FIND_VERSION VERSION_GREATER
               "@MCP_CPP_SDK_VERSION_CORE@")
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()

    if(@MCP_CPP_SDK_VERSION_MAJOR@ EQUAL 0)
      if(NOT PACKAGE_FIND_VERSION_RANGE
         AND PACKAGE_FIND_VERSION STREQUAL "@MCP_CPP_SDK_VERSION_CORE@")
        set(PACKAGE_VERSION_EXACT TRUE)
      endif()
    elseif(PACKAGE_FIND_VERSION VERSION_EQUAL "@MCP_CPP_SDK_VERSION_CORE@")
      set(PACKAGE_VERSION_EXACT TRUE)
    endif()
  else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
elseif(PACKAGE_FIND_VERSION)
  if(PACKAGE_FIND_VERSION STREQUAL "@MCP_CPP_SDK_VERSION_FULL@")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()

if(PACKAGE_FIND_VERSION_RANGE AND PACKAGE_VERSION_COMPATIBLE)
  if(PACKAGE_FIND_VERSION_RANGE_MIN STREQUAL "EXCLUDE"
     AND PACKAGE_FIND_VERSION VERSION_EQUAL "@MCP_CPP_SDK_VERSION_CORE@")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
  if(PACKAGE_FIND_VERSION_MAX)
    if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE"
       AND "@MCP_CPP_SDK_VERSION_CORE@" VERSION_GREATER
           PACKAGE_FIND_VERSION_MAX)
      set(PACKAGE_VERSION_COMPATIBLE FALSE)
    elseif(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE"
           AND NOT "@MCP_CPP_SDK_VERSION_CORE@" VERSION_LESS
               PACKAGE_FIND_VERSION_MAX)
      set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()
  endif()
endif()
